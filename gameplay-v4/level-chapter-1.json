      "id": "shortcut",
      "speaker": "Senti",
      "text": "Tiếng động trên cao. Phải tìm đường lên mái nhà... cô ấy không ở dưới này."
    },
    {
      "m": 310,
      "id": "empty-city",
      "speaker": "Senti",
      "text": "Không người. Không tiếng xe. Chỉ có quái và tiếng đánh nhau ở phía trước..."
    },
    {
      "m": 405,
      "id": "roof",
      "speaker": "Senti",
      "text": "Old Timer! Nếu nghe thấy thì trả lời ta một tiếng!"
    },
    {
      "m": 505,
      "id": "quiet",
      "speaker": "Senti",
      "text": "...Lại im rồi. Đừng nói là ta vừa nghe nhầm."
    },
    {
      "m": 605,
      "id": "crumble",
      "speaker": "Senti",
      "text": "Đứng lâu là nền vỡ. Thành phố này đúng là không muốn giữ khách."
    },
    {
      "m": 720,
      "id": "glimpse",
      "speaker": "Senti",
      "text": "Áo trắng ở bên kia! Khoan— biến mất rồi?"
    },
    {
      "m": 810,
      "id": "fracture",
      "speaker": "Senti",
      "text": "Con đường vừa nhấp nháy. Không phải mắt ta. Là chính nó."
    },
    {
      "id": "snow-lore",
      "m": 963,
      "speaker": "Senti",
      "text": "Tuyết ở Nagazora? Một ký ức khác đang tràn vào... phải qua trước khi nó nuốt cả con phố."
    },
    {
      "m": 980,
      "id": "kitchen-echo",
      "speaker": "Senti",
      "text": "Những thứ nhỏ nhặt thế này mà cũng bị nhốt lại... ai lại muốn giữ cả một căn bếp cháy?",
      "requiresMemory": "hidden-1"
    },
    {
      "id": "lava-lore",
      "m": 1030,
      "speaker": "Senti",
      "text": "Mặt đường đỏ lên rồi. Không phải ánh đèn. Đừng chạm xuống khe nứt."
    },
    {
      "m": 1080,
      "id": "warmth",
      "speaker": "Senti",
      "text": "Ta nhớ cảm giác này. Không nhớ vì sao. Nhưng ta biết nó thuộc về Old Timer."
    },
    {
      "m": 1190,
      "id": "redlight",
      "speaker": "Senti",
      "text": "Đèn đỏ. Vết nứt trên biển báo. Ta đã đi qua chỗ này rồi."
    },
    {
      "m": 1370,
      "id": "first-break",
      "speaker": "Senti",
      "text": "Một vết nứt đã biến mất. Lần này không còn quay lại từ đầu nữa."
    },
    {
      "m": 1480,
      "id": "resolve",
      "speaker": "Senti",
      "text": "Old Timer cứ thích tự mình gánh hết. Đến cả trong ký ức cũng vậy."
    },
    {
      "m": 1570,
      "id": "three-locks",
      "speaker": "Senti",
      "text": "Ba nút còn lại đang nối vào cô ấy. Phải chém theo dòng sáng, từ ngoài vào trong."
    },
    {
      "m": 1640,
      "id": "heard",
      "speaker": "Senti",
      "text": "Cô ấy vừa quay đầu. Ta thấy rồi. Chỉ cần thêm một chút nữa."
    },
    {
      "m": 1800,
      "id": "collapse",
      "speaker": "Senti",
      "text": "Nút vỡ rồi, cả Nagazora cũng bắt đầu tan theo. Không được dừng."
    },
    {
      "m": 1900,
      "id": "last",
      "speaker": "Senti",
      "text": "Ta tới đây. Lần này cô không phải đứng dậy một mình nữa."
    }
  ],
  "investigations": [
    {
      "m": 285,
      "id": "broken-sign",
      "title": "BIỂN CHỈ ĐƯỜNG BỊ XÓA",
      "lines": [
        [
          "Senti",
          "Tên đường bị xóa sạch. Nhưng vết nứt thì còn."
